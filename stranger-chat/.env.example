# MongoDB (Atlas ya local). Bina MongoDB ke random chat chalega, friends system nahi.
MONGODB_URI=mongodb://127.0.0.1:27017/stranger-chat

PORT=3000
# Production mein apna domain (comma separated). Dev mein khali chhod sakte ho.
CORS_ORIGIN=

# Optional TURN relay (strict networks par P2P fail hone par kaam aata hai)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_PASS=
